#include <stdio.h>
#include <string.h>
#include <windows.h>
#include <ctype.h>
#include <stdlib.h>
void limpar_buffer(void){
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

int main(){
    char item[100];
    int qntd;
    char remov[100];
    int qntd_r;
    char linha[1000];
    int encontrado = 0;
    int opcao = 0;

    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    do {
        printf("\n==================================\n");
        printf("   Controle de Estoque\n");
        printf("==================================\n");
        printf("1. Adicionar Item\n");
        printf("2. Remover Item\n");
        printf("3. Listar Estoque\n");
        printf("4. Sair\n");
        printf("Selecione uma opção: ");

        int lido = scanf("%d", &opcao);
        if (lido == EOF) {
            break;
        }
        limpar_buffer();
        if (lido != 1) {
            printf("Opção inválida! Tente novamente.\n");
            continue;
        }

        switch(opcao){
            case 1: {
                printf("Digite o nome do item: ");
                fgets(item, sizeof(item), stdin);
                item[strcspn(item, "\r\n")] = '\0';

                printf("Digite a quantidade: ");
                scanf("%d", &qntd);
                limpar_buffer();

                FILE *arquivo = fopen("inventory.txt", "a");
                if (arquivo == NULL) {
                    break;
                }
                fprintf(arquivo, "%s\n", item);
                fprintf(arquivo, "%d\n", qntd);
                fclose(arquivo);

                printf("Item adicionado com sucesso!\n");
                break;
            }
            case 2: {
                printf("Digite o nome do item: ");
                fgets(remov, sizeof(remov), stdin);
                remov[strcspn(remov, "\r\n")] = '\0';

                printf("Digite a quantidade a ser removida: ");
                scanf("%d", &qntd_r);
                limpar_buffer();

                FILE *arquivo = fopen("inventory.txt", "r");
                if (arquivo == NULL) {
                    printf("Item não encontrado.\n");
                    break;
                }

                FILE *tempo = fopen("temporary.txt", "w");
                if (tempo == NULL) {
                    fclose(arquivo);
                    break;
                }
                encontrado = 0;

                
                while (fgets(linha, sizeof(linha), arquivo) != NULL) {
                    char linha_qtd[100];
                    if (fgets(linha_qtd, sizeof(linha_qtd), arquivo) == NULL) {
                        break;
                    }
                    linha[strcspn(linha, "\r\n")] = '\0';
                    int qtd_atual = atoi(linha_qtd);

                    if (strcmp(linha, remov) == 0) {
                        encontrado = 1;

                        if (qntd_r > qtd_atual) {
                            printf("Estoque insuficiente. Quantidade disponível: %d\n", qtd_atual);
                            fprintf(tempo, "%s\n%d\n", linha, qtd_atual);
                        }
                        else if (qntd_r == qtd_atual) {
                            printf("Item removido do estoque!\n");
                        }
                        else {
                            fprintf(tempo, "%s\n%d\n", linha, qtd_atual - qntd_r);
                            printf("Quantidade atualizada com sucesso!\n");
                        }
                    }
                    else {
                        fprintf(tempo, "%s\n%d\n", linha, qtd_atual);
                    }
                }

                if (encontrado == 0) {
                    printf("Item não encontrado.\n");
                }

                fclose(tempo);
                fclose(arquivo);

                remove("inventory.txt");
                rename("temporary.txt", "inventory.txt");
                break;
            }
            case 3: {
                FILE *arqlist = fopen("inventory.txt", "r");
                int total = 0;

                if (arqlist != NULL) {
                    char nome[100];
                    char linha_qtd[100];

                    while (fgets(nome, sizeof(nome), arqlist) != NULL &&
                           fgets(linha_qtd, sizeof(linha_qtd), arqlist) != NULL) {
                        nome[strcspn(nome, "\r\n")] = '\0';

                        if (total == 0) {
                            printf("=============================\n");
                            printf("        Estoque Atual\n");
                            printf("=============================\n");
                        } else {
                            printf("\n");
                        }
                        printf("Nome: %s\n", nome);
                        printf("Quantidade: %d\n", atoi(linha_qtd));
                        total++;
                    }
                    fclose(arqlist);
                }

                if (total == 0) {
                    printf("O estoque está vazio.\n");
                }
                break;
            }
            case 4:
                printf("Obrigado por usar o Controle de Estoques! Até a próxima.\n");
                break;
            default:
                printf("Opção inválida! Tente novamente.\n");
                break;
        }
    } while (opcao != 4);

    return 0;
}
